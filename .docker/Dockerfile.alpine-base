FROM alpine:edge@sha256:020dfcbaaf4cc1078bf2d9c7ba31a8466e334061dcd2f248001d68f79e52c000 AS base

LABEL org.opencontainers.image.source="https://github.com/mhx/dwarfs"

RUN apk upgrade --no-cache && \
    apk add --no-cache \
        bash-completion \
        build-base \
        wget \
        curl \
        vim \
        tar \
        ripgrep \
        less \
        gcc \
        g++ \
        clang23 \
        llvm23 \
        lld \
        git \
        xz \
        gzip \
        bzip2 \
        zstd \
        ccache \
        ninja-build \
        cmake \
        make \
        bison \
        flex \
        flock \
        mandoc \
        perf \
        hyperfine \
        py3-markdown-it-py \
        py3-pip \
        py3-xxhash \
        py3-zstd \
        py3-lz4 \
        fuse \
        fuse3 \
        pkgconf \
        meson \
        autoconf \
        strace \
        gdb \
        gmp-dev \
        util-linux \
        zlib-static \
        zstd-static \
        zlib-dev \
        zstd-dev \
        mpfr-dev \
        mpc1-dev \
        isl-dev \
        texinfo \
        linux-headers \
        gdb-multiarch \
        rsync \
        screen \
        qemu-arm \
        qemu-armeb \
        qemu-i386 \
        qemu-mips \
        qemu-mipsel \
        qemu-ppc \
        qemu-riscv32 \
        qemu-sparc \
        qemu-aarch64 \
        qemu-aarch64_be \
        qemu-alpha \
        qemu-hppa \
        qemu-loongarch64 \
        qemu-mips64 \
        qemu-mips64el \
        qemu-ppc64 \
        qemu-ppc64le \
        qemu-riscv64 \
        qemu-s390x \
        qemu-sparc64

RUN mkdir -p /usr/share/dwarfs-buildenv && \
    apk info -v | LC_ALL=C sort > /usr/share/dwarfs-buildenv/packages.txt
