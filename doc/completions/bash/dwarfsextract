#
# bash completion for dwarfsextract
#
# synopsis
#   dwarfsextract -i <image> [-o <dir>] [OPTIONS...] [<pattern>...]
#   dwarfsextract -i <image> -f <format> [-o <file>] [OPTIONS...] [<pattern>...]
#

__dwarfsextract_additional_options()
{
    if dwarfsextract -h | grep -qe ' *--man'; then
        echo "--man"
    fi
}

# complete DwarFS images; if the directory being completed doesn't contain
# any *.dwarfs files, fall back to completing all files
__dwarfsextract_image_files()
{
    local i n=${#COMPREPLY[@]}
    _comp_compgen -a filedir dwarfs
    for (( i=n; i < ${#COMPREPLY[@]}; i++ )); do
        # anything that isn't a directory is an actual image file
        [[ -d ${COMPREPLY[i]} ]] || return 0
    done
    _comp_compgen -a filedir
}

_dwarfsextract_completion()
{
    local cur prev words cword split
    _comp_initialize -s || return

    local OPTIONS_GENERAL=(
        --continue-on-error
        --disable-integrity-check
        --format-filters
        --format-options
        --log-level
        --log-with-context
        --num-disk-writers
        --pattern
        --perfmon
        --perfmon-trace
        --skip-devices
        --skip-specials
        --stdout-progress
        -f --format
        -h --help
        -i --input
        -n --num-workers
        -O --image-offset
        -o --output
        -s --cache-size
        $(__dwarfsextract_additional_options)
    )

    local OPTION_ARG__log_level=( error warn info verbose debug trace )
    local OPTION_ARG__perfmon=( filesystem_v2 metadata inode_reader_v2 block_cache )
    # libarchive write formats, see libarchive-formats(5)
    local OPTION_ARG__format=( auto 7zip ar arbsd argnu arsvr4 bsdtar cd9660
        cpio gnutar iso9660 mtree mtree-classic newc odc oldgnutar oldtar pax
        paxr posix raw rpax shar shardump ustar v7tar warc xar zip )
    # libarchive filters, see libarchive-formats(5)
    local OPTION_ARG__format_filters=( b64encode bzip2 compress grzip gzip
        lrzip lz4 lzip lzma lzop uuencode xz zstd )
    # silent, no completion
    local OPTION_ARG_NONE=( --cache-size --format-options --image-offset
        --num-disk-writers --num-workers --pattern -n -O -s )

    # catch options with known arguments first
    case $prev in
        --log-level)
            _comp_compgen -- -W '"${OPTION_ARG__log_level[@]}"'
            return 0
            ;;
        --perfmon)
            _comp_compgen -- -W '"${OPTION_ARG__perfmon[@]}"'
            return 0
            ;;
        -f | --format)
            _comp_compgen -- -W '"${OPTION_ARG__format[@]}"'
            return 0
            ;;
        --format-filters)
            _comp_compgen -- -W '"${OPTION_ARG__format_filters[@]}"'
            return 0
            ;;
        -O | --image-offset)
            _comp_compgen -- -W 'auto'
            return 0
            ;;
        -i | --input)
            __dwarfsextract_image_files
            return 0
            ;;
        --perfmon-trace | -o | --output)
            _comp_compgen -a filedir
            return 0
            ;;
    esac

    # check if previous option is silent
    if [[ $prev == -* ]]; then
        for f in ${OPTION_ARG_NONE[@]}; do
            [[ "$prev" = "$f" ]] && return 0
        done
    fi

    # `--option=<TAB>` for an option we don't know how to complete
    [[ $split == true ]] && return 0

    # show all options; positional arguments are glob patterns matching paths
    # *inside* the image, so there's nothing sensible to complete for them
    _comp_compgen -- -W '"${OPTIONS_GENERAL[@]}"'

    return 0
} &&
complete -F _dwarfsextract_completion dwarfsextract
