#
# bash completion for dwarfs
#
# synopsis
#   dwarfs <image.dwarfs> <mountpoint> [-o option]...
#   dwarfs <image.dwarfs> --auto-mountpoint [-o option]...
#

__dwarfs_additional_options()
{
    if dwarfs -h | grep -qe ' *--man'; then
        echo "--man"
    fi
}

# complete DwarFS images; if the directory being completed doesn't contain
# any *.dwarfs files, fall back to completing all files
__dwarfs_image_files()
{
    local i n=${#COMPREPLY[@]}
    _comp_compgen -a filedir dwarfs
    for (( i=n; i < ${#COMPREPLY[@]}; i++ )); do
        # anything that isn't a directory is an actual image file
        [[ -d ${COMPREPLY[i]} ]] || return 0
    done
    _comp_compgen -a filedir
}

_dwarfs_completion()
{
    local cur prev words cword
    # `=` must not be a word break character, otherwise we cannot tell which
    # suboption a `-o name=value` argument belongs to
    _comp_initialize -n = || return

    # options that show up at any position
    local OPTIONS_GENERAL=(
        -d -f -o -s
    )
    # options that show up at first position and not followed by anything
    local OPTIONS_GENERAL_FIRST=(
        -h --help $(__dwarfs_additional_options)
    )

    local OPTION_ARG__owitharg=( analysis_file block_allocator blocksize
        cachesize debuglevel decratio gid imagesize io_uring_q_depth
        max_idle_threads max_threads mlock offset perfmon perfmon_trace
        preload_category readahead seq_detector tidy_interval tidy_max_age
        tidy_strategy uid workers )
    local OPTION_ARG__onoarg=( allow_other allow_root auto_unmount cache_files
        cache_sparse case_insensitive clone_fd debug io_uring no_cache_files
        no_cache_sparse preload_all readonly )

    # values for the -o suboptions that have a fixed set of arguments
    local OPTION_ARG__block_allocator=( malloc mmap )
    local OPTION_ARG__debuglevel=( error warn info verbose debug trace )
    local OPTION_ARG__mlock=( none try must )
    local OPTION_ARG__offset=( auto )
    local OPTION_ARG__tidy_strategy=( none time swap )

    # catch option with known arguments first
    case $prev in
        -o )
            # `-o name=<TAB>`: complete the suboption value if we know it
            if [[ $cur == *=* ]]; then
                local subopt=${cur%%=*}
                local subval=${cur#*=}
                case $subopt in
                    block_allocator | debuglevel | mlock | offset | \
                    tidy_strategy )
                        _comp_compgen -c "$subval" -- \
                            -W '"${OPTION_ARG__'$subopt'[@]}"' -P "$subopt="
                        ;;
                esac
                return 0
            fi
            _comp_compgen -- -W '"${OPTION_ARG__owitharg[@]}"' -S "="
            _comp_compgen -a -- -W '"${OPTION_ARG__onoarg[@]}"'
            return 0
            ;;
        -h | --help | --man )
            # nothing else to add
            return 0
            ;;
    esac

    # count non-option args (including --a-mp as second arg)
    local carg=1 i
    for (( i=1; i < ${cword}; i++ )); do
        if [[ ( ${words[i]} != -* && ${words[i-1]} != "-o" ) ||
                ${words[i]} == "--auto-mountpoint" ]]; then
            carg=$((carg+1))
        fi
    done

    if [[ $carg == 2 ]]; then
        # second arg is dir or --auto-mp
        _comp_compgen -- -W '"--auto-mountpoint"'
        _comp_compgen -a -- -d
    elif [[ $cur == -* || $carg -gt 2 ]]; then
        # cursor on an option or already have 2 args, show options only
        _comp_compgen -- -W '"${OPTIONS_GENERAL[@]}"'
        if [[ $carg -eq 1 ]]; then
            _comp_compgen -a -- -W '"${OPTIONS_GENERAL_FIRST[@]}"'
        fi
    else
        # show all options and dwarfs files to start
        _comp_compgen -- -W '"${OPTIONS_GENERAL[@]}"'
        _comp_compgen -a -- -W '"${OPTIONS_GENERAL_FIRST[@]}"'
        __dwarfs_image_files
    fi

    return 0
} &&
complete -F _dwarfs_completion dwarfs
